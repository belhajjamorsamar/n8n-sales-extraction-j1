        "body": "=SELECT      Date,     Magasin,     Produit,     Designation,     Famille,     SousFamille,     Rayon,     saison,     sum(Quantite) AS QuantiteTotale FROM ventes_flat WHERE Date = '{{ $json.date_j1 }}' GROUP BY      Date,     Magasin,     Produit,     Designation,     Famille,     SousFamille,     Rayon,     saison ORDER BY QuantiteTotale DESC FORMAT CSVWithNames",
