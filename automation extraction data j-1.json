      "parameters": {
        "jsCode": "const binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst textData = binaryData.toString('utf-8');\n\nconst lines = textData.trim().split('\\n');\nconst headers = lines[0].replace(/\"/g, '').split(',');\n\nconst items = [];\nfor (let i = 1; i < lines.length; i++) {\n  if (!lines[i].trim()) continue;\n  const values = lines[i].replace(/\"/g, '').split(',');\n  const row = {};\n  \n  headers.forEach((header, index) => {\n    let val = values[index] ? values[index].trim() : '';\n    val = val.replace(/spÃ©ciaux/g, 'spéciaux');\n    \n    if (header.toLowerCase().includes('quantite')) {\n      row[header] = parseFloat(val) || 0;\n    } else {\n      row[header] = val;\n    }\n  });\n  \n  items.push({ json: row });\n}\n\nreturn items;"
      },
